[Unit]
Description=NFL Tracker API
After=network.target

[Service]
WorkingDirectory=/var/www/nfltracker/api
ExecStart=/var/www/nfltracker/api/NflTracker.Api
Restart=always
RestartSec=10
KillSignal=SIGINT

User=www-data
Group=www-data

EnvironmentFile=/etc/nfltracker/env

[Install]
WantedBy=multi-user.target
